# test folder for load-speed experiments (safe to delete)
<IfModule mod_headers.c>
  <FilesMatch "^b\.framework\.js\.unityweb$">
    Header set Content-Encoding br
    Header set Content-Type application/javascript
    Header set Cache-Control "public, max-age=60, no-transform"
  </FilesMatch>
  <FilesMatch "^c\.framework\.js\.unityweb$">
    Header set Content-Encoding br
    Header set Content-Type application/javascript
    Header set Cache-Control "public, max-age=60"
  </FilesMatch>
  <FilesMatch "^a\.">
    Header set Cache-Control "public, max-age=60"
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^b\. - [E=no-gzip:1,E=no-brotli:1,E=noconntimeout:1]
</IfModule>
