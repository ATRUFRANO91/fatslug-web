# FATSLUG web build on Hostinger (LiteSpeed/Apache)
# Unity files are Brotli-compressed; let the browser unpack them natively (faster than the JS fallback).
<IfModule mod_headers.c>
  <FilesMatch "\.wasm\.unityweb$">
    Header set Content-Encoding br
    Header set Content-Type application/wasm
  </FilesMatch>
  <FilesMatch "\.framework\.js\.unityweb$">
    Header set Content-Encoding br
    Header set Content-Type application/javascript
  </FilesMatch>
  <FilesMatch "\.data\.unityweb$">
    Header set Content-Encoding br
    Header set Content-Type application/octet-stream
  </FilesMatch>
  # build files have hashed names and images are versioned (-v2), so they can be cached for a long time.
  # Change an image? Give it a new name (-v3) or browsers keep the old one for a year.
  <FilesMatch "\.(unityweb|png|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # fixed names browsers ask for on their own: recheck daily so a new icon shows up
  <FilesMatch "^(favicon\.ico|apple-touch-icon\.png|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.unityweb$" no-gzip
</IfModule>
